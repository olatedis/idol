# --- 필수 운영 환경 변수 ---

# 1. 공통 설정
DB_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_key_here
AWS_PUBLIC_IP=your_ec2_public_ip

# 2. 외부 API 키
KAKAO_CLIENT_ID=your_kakao_client_id
