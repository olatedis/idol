AWS_SECRET_KEY=your_aws_secret_key
OPENAI_API_KEY=your_openai_api_key
DEEPL_API_KEY=your_deepl_api_key

# 3. 내부 보안 키
INTERNAL_KEY=your_internal_microservice_key
